      "optional": true
    }
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "catalog:bundle",
    "@typescript-eslint/parser": "catalog:bundle",
    "eslint-plugin-antfu": "catalog:bundle",
    "eslint-plugin-unused-imports": "catalog:bundle"
  },
  "devDependencies": {
    "@lumirelle/tsconfig": "catalog:types",
    "eslint": "catalog:check",
    "tsdown": "catalog:build",
    "typescript": "catalog:types"
  }
