{
  "ignoreDependencies": [
    // Quality
    "@arethetypeswrong/cli",
    "publint",
    // Optional peers the ESLint Adapter imports by their registry name, so knip sees no import;
    // the framework peers are also only reachable through `isPackageInstalled` and the registry
    "@angular-eslint/eslint-plugin",
    "@angular-eslint/eslint-plugin-template",
    "@angular-eslint/template-parser",
    "@eslint-react/eslint-plugin",
    "@next/eslint-plugin-next",
    "@unocss/eslint-plugin",
    "astro-eslint-parser",
    "eslint-plugin-astro",
    "eslint-plugin-erasable-syntax-only",
    "eslint-plugin-format",
    "eslint-plugin-react-refresh",
    "eslint-plugin-solid",
    "eslint-plugin-svelte",
    "eslint-plugin-vuejs-accessibility",
    "svelte-eslint-parser",
    // Runtime frameworks the examples simulate and deliberately do not install: an example's source
    // tree is a consumer snapshot, so its entry file imports the framework the example leaves out.
    // One entry per framework, so a later example adds only its own.
    "next",
    "react",
    "react-dom",
    "vue",
    // Referenced as an Oxlint jsPlugins specifier string, which knip cannot follow
    "@eslint-community/eslint-plugin-eslint-comments",
    // Peer packages loaded by a plugin's own resolution at runtime (eslint-plugin-jsx-a11y by
    // Upstream's react preset, `svelte` by svelte-eslint-parser), never imported by name here
    "eslint-plugin-jsx-a11y",
    "svelte",
    "eslint-plugin-command",
    "eslint-plugin-perfectionist",
    "eslint-plugin-slop",
    "eslint-plugin-sonarjs",
    // Node.js dependencies manager
    "taze",
    // Node.js releasing tools
    "changelogithub",
    // Docs
    "@iconify-json/svg-spinners",
    "@unocss/reset",
    "@vueuse/core",
    "floating-vue",
    "oxc-minify",
    "pinia",
    "uno.css"
  ],
  "workspaces": {
    // The root workspace is configured here because a `workspaces` block makes knip read every
    // workspace, including the root one, from this mapping.
    ".": {
      "entry": ["scripts/*.ts", "playground/index.ts", "playground/examples.ts"],
      "ignore": [
        // Upstream source for reading and comparison; not part of this workspace
        "upstream/**"
      ],
      "ignoreFiles": [
        // Snapshots
        "test/__snapshots__/**",
        // Linted by the fixture test, never imported
        "packages/config/test/fixtures/**",
        // Loaded by taze at runtime; knip has no plugin for it
        "taze.config.js"
      ]
    },
    // An example is a consumer snapshot, not a library with a single index: its options module and
    // the two config modules built from it are the whole program. Globbed, so a later example
    // package needs no edit here; a declared peer is covered by the root `ignoreDependencies`
    // above, which a workspace inherits. `packages/*/src/**/*` is a monorepo example's nested
    // package sources, which the workspace glob does not make workspaces of their own.
    "playground/*": {
      "entry": [
        // The paired lint configs and the framework config files an example keeps — the
        // `uno.config.ts` a UnoCSS project needs before its plugin can order a class name. Nothing
        // imports them, and they are part of the snapshot rather than dead code.
        "*.config.{js,ts}",
        "options.ts",
        "src/**/*",
        "app/**/*",
        "packages/*/src/**/*"
      ]
    },
    // The flavor-grouped layout: `playground/<flavor>/<stack>` is the same consumer snapshot, with
    // the entries above. Both keys stay because both layouts are accepted; neither names an
    // example, so a later stack is discovered by being a directory.
    "playground/*/*": {
      "entry": [
        "*.config.{js,ts}",
        "options.ts",
        "src/**/*",
        "app/**/*",
        "packages/*/src/**/*"
      ]
    }
  }
}
