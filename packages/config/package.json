{
  "name": "@lumirelle/linter-config",
  "type": "module",
  "version": "0.0.0",
  "description": "Lumirelle's opinionated linter config.",
  "author": "Lumirelle <lumirelle@outlook.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/lumirelle",
  "homepage": "https://github.com/lumirelle/linter-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumirelle/linter-config.git"
  },
  "bugs": "https://github.com/lumirelle/linter-config/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    "./eslint": {
      "import": {
        "types": "./dist/eslint.d.mts",
        "default": "./dist/eslint.mjs"
      }
    },
    "./oxlint": {
      "import": {
        "types": "./dist/oxlint.d.mts",
        "default": "./dist/oxlint.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">22",
    "bun": ">1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@lumirelle/linter-plugins-eslint": "workspace:^",
    "@lumirelle/linter-plugins-oxlint": "workspace:^",
    "eslint": "^9.10.0 || ^10.0.0",
    "oxlint": ">=1.85.0"
  },
  "peerDependenciesMeta": {
    "@lumirelle/linter-plugins-eslint": {
      "optional": true
    },
    "@lumirelle/linter-plugins-oxlint": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "dependencies": {
    "@oxlint-flat-config/composer": "catalog:lint",
    "eslint-config-flat-gitignore": "catalog:lint",
    "eslint-flat-config-utils": "catalog:lint",
    "globals": "catalog:lint",
    "oxlint-flat-config": "catalog:lint"
  },
  "devDependencies": {
    "@lumirelle/linter-plugins-eslint": "workspace:*",
    "@lumirelle/linter-plugins-oxlint": "workspace:*",
    "@lumirelle/tsconfig": "catalog:types",
    "@stylistic/eslint-plugin": "catalog:bundle",
    "eslint": "catalog:check",
    "eslint-plugin-erasable-syntax-only": "catalog:peer",
    "fast-glob": "catalog:test",
    "minimatch": "catalog:test",
    "oxlint": "catalog:check",
    "tsdown": "catalog:build",
    "typescript": "catalog:types",
    "vitest": "catalog:test"
  }
}
