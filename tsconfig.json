{
  "extends": "@lumirelle/tsconfig/ts",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "scripts/**/*",
    "test/**/*",
    "config/**/*",
    "*.config.js",
    "*.config.ts",

    // The example registry and runner, plus each example's config modules, options module and
    // UnoCSS/Vite config: root ESLint lints them with the type-aware parser, so they must be
    // here.
    "playground/*.ts",
    "playground/*/*/options.ts",
    "playground/*/*/eslint.config.js",
    "playground/*/*/oxlint.config.ts",
    "playground/*/*/uno.config.ts",
    "playground/*/*/vite.config.ts"
  ]
}
