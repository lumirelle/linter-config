      },
      {
        "key": "ts/no-unsafe-return",
        "reason": "type-aware"
      },
      {
        "key": "ts/no-unused-expressions",
        "reason": "unknown-rule"
      },
      {
        "key": "ts/no-unused-vars",
        "reason": "unknown-rule"
      },
      {
        "key": "ts/no-use-before-define",
        "reason": "unknown-rule"
      },
      {
        "key": "ts/no-useless-constructor",
        "reason": "unknown-rule"
      },
      {
        "key": "ts/promise-function-async",
        "reason": "type-aware"
      },
      {
        "key": "ts/restrict-plus-operands",
        "reason": "type-aware"
      },
      {
        "key": "ts/restrict-template-expressions",
        "reason": "type-aware"
      },
      {
        "key": "ts/return-await",
        "reason": "type-aware"
      },
      {
        "key": "ts/strict-boolean-expressions",
        "reason": "type-aware"
      },
      {
        "key": "ts/switch-exhaustiveness-check",
        "reason": "type-aware"
      },
      {
        "key": "ts/unbound-method",
        "reason": "type-aware"
      }
    ]
  }
}
