{
  "extends": "@lumirelle/tsconfig/ts",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "scripts/**/*",
    "test/**/*",
    // The example registry and runner, plus each example's options module and Oxlint config: root
    // ESLint lints them with the type-aware parser, so they must be in a project. `uno.config.ts` is
    // here for the same reason: it imports nothing, and in an Oxlint-only flavor there is no example
    // ESLint config module for ESLint's config lookup to find, so the root config is what lints it.
    // The examples' own tsconfigs and source trees stay out of this repository's type check.
    "playground/*.ts",
    "playground/*/options.ts",
    "playground/*/oxlint.config.ts",
    "playground/*/*/options.ts",
    "playground/*/*/oxlint.config.ts",
    "playground/*/*/uno.config.ts",
    "*.config.js",
    "*.config.ts",
    "lint-options.ts"
  ]
}
