{
  "oxlintVersion": "1.88.0",
  "jsPlugins": [
    "antfu",
    "style",
    "unused-imports"
  ],
  "blacklist": [
    {
      "id": "eslint-comments",
      "failure": "`no-unlimited-disable` throws `RangeError: Line/column pair translates to an out of range offset` out of Oxlint's report shim on a block `/* eslint-disable */` directive: on the first line Oxlint reports `Error running JS plugin`, anywhere else the rule silently misses the directive. Only the line-comment form works, so the plugin cannot be trusted to see the block directives it exists for."
    }
  ],
  "modules": {
    "disables": [
      {
        "key": "no-restricted-syntax",
        "reason": "unknown-rule"
      }
    ],
    "imports": [
      {
        "key": "import/consistent-type-specifier-style",
        "reason": "incompatible-options"
      }
    ],
    "javascript": [
      {
        "key": "dot-notation",
        "reason": "unknown-rule"
      },
      {
        "key": "no-dupe-args",
        "reason": "unknown-rule"
      },
      {
        "key": "no-octal",
        "reason": "unknown-rule"
      },
      {
        "key": "no-octal-escape",
        "reason": "unknown-rule"
      },
      {
        "key": "no-restricted-syntax",
        "reason": "unknown-rule"
      },
      {
        "key": "no-undef-init",
        "reason": "unknown-rule"
      }
    ],
    "jsdoc": [
      {
        "key": "jsdoc/check-alignment",
        "reason": "unknown-rule"
      },
      {
        "key": "jsdoc/check-param-names",
        "reason": "unknown-rule"
      },
      {
        "key": "jsdoc/check-types",
        "reason": "unknown-rule"
      },
      {
        "key": "jsdoc/multiline-blocks",
        "reason": "unknown-rule"
      },
      {
        "key": "jsdoc/no-multi-asterisks",
        "reason": "unknown-rule"
      },
      {
        "key": "jsdoc/require-returns-check",
        "reason": "unknown-rule"
      },
      {
        "key": "jsdoc/require-yields-check",
        "reason": "unknown-rule"
      }
    ],
    "node": [
      {
        "key": "node/no-deprecated-api",
        "reason": "unknown-rule"
      },
      {
        "key": "node/prefer-global/buffer",
        "reason": "unknown-rule"
      },
      {
        "key": "node/prefer-global/process",
        "reason": "unknown-rule"
      },
      {
        "key": "node/process-exit-as-throw",
        "reason": "unknown-rule"
      }
    ],
    "test": [
      {
        "key": "node/prefer-global/process",
        "reason": "unknown-rule"
      },
      {
        "key": "test/no-only-tests",
        "oxlint": "vitest/no-focused-tests",
        "reason": "renamed-rule"
      }
    ],
    "typescript": [
      {
        "key": "dot-notation",
        "reason": "unknown-rule"
      },
      {
        "key": "erasable-syntax-only/enums",
        "reason": "no-oxlint-realization"
      },
      {
        "key": "erasable-syntax-only/export-aliases",
        "reason": "no-oxlint-realization"
      },
      {
        "key": "erasable-syntax-only/import-aliases",
        "reason": "no-oxlint-realization"
      },
      {
        "key": "erasable-syntax-only/namespaces",
        "reason": "no-oxlint-realization"
      },
      {
        "key": "erasable-syntax-only/parameter-properties",
        "reason": "no-oxlint-realization"
      },
      {
        "key": "no-dupe-args",
        "reason": "unknown-rule"
      },
      {
        "key": "no-new-symbol",
        "reason": "unknown-rule"
      },
      {
        "key": "ts/await-thenable",
        "reason": "type-aware"
      },
      {
        "key": "ts/dot-notation",
        "reason": "type-aware"
      },
      {
        "key": "ts/no-array-constructor",
        "reason": "unknown-rule"
      },
      {
        "key": "ts/no-dupe-class-members",
        "reason": "unknown-rule"
      },
      {
        "key": "ts/no-floating-promises",
        "reason": "type-aware"
      },
      {
        "key": "ts/no-for-in-array",
        "reason": "type-aware"
      },
      {
        "key": "ts/no-implied-eval",
        "reason": "type-aware"
      },
      {
        "key": "ts/no-misused-promises",
        "reason": "type-aware"
      },
      {
        "key": "ts/no-redeclare",
        "reason": "unknown-rule"
      },
      {
        "key": "ts/no-unnecessary-type-assertion",
        "reason": "type-aware"
      },
      {
        "key": "ts/no-unsafe-argument",
        "reason": "type-aware"
      },
      {
        "key": "ts/no-unsafe-assignment",
