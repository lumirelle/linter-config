{
  "extends": "@lumirelle/tsconfig/ts",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "scripts/**/*",
    "test/**/*",
    // The example registry and runner, plus each example's config modules, options module and
    // UnoCSS/Vite config: root ESLint lints them with the type-aware parser, so they must be in a
    // project, and a single-tool flavor writes its options inside its config module, which is why
    // `eslint.config.js` is here beside `oxlint.config.ts`. The two framework configs are here
    // because a flavor that ships no ESLint config module leaves them to the root config, and they
    // import nothing to resolve. The examples' own tsconfigs and source trees stay out of this
    // repository's type check.
    "playground/*.ts",
    "playground/*/*/options.ts",
    "playground/*/*/eslint.config.js",
    "playground/*/*/oxlint.config.ts",
    "playground/*/*/uno.config.ts",
    "playground/*/*/vite.config.ts",
    "*.config.js",
    "*.config.ts",
    "config/**/*"
  ]
}
