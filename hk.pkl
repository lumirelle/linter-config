amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  // Code
  ["oxlint"] = (Builtins.ox_lint) {
    // Oxlint's allocator keeps one pool per worker thread. On a small CI runner the whole tree
    // plus the js-plugin bridge is enough to exhaust a pool, which panics inside Oxlint
    // (`oxc_allocator::pool::fixed_size`). One thread holds one pool and costs about 8%.
    // `--disable-nested-config` keeps the example packages' own root configs from being treated
    // as nested configs of this repository: an example's `options.typeAware` is legal where the
    // example runs Oxlint itself, but Oxlint only accepts it in the process root config.
    check = new CommandSpec {
      command = new Command {
        argv =
          List("oxlint", "--deny-warnings", "--threads=1", "--disable-nested-config", "{{files}}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv =
          List(
            "oxlint",
            "--deny-warnings",
            "--fix",
            "--threads=1",
            "--disable-nested-config",
            "{{files}}",
          )
      }
      effect = "write"
    }
  }
  ["eslint"] = (Builtins.eslint) {
    batch = false
    glob =
      List(
        // Code
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.mts",
        "*.cts",
        "*.tsx",
        // Configurations
        "*.json",
        "*.jsonc",
        "*.yaml",
        "*.yml",
        "*.toml",
        // Documentations
        "*.md",
        "*.mdc",
        "*.mdx",
      )
    check = new CommandSpec {
      command = new Command { argv = List("eslint", "--no-warn-ignored", "{{files}}") }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("eslint", "--no-warn-ignored", "--fix", "{{files}}")
      }
      effect = "write"
    }
    depends = List("oxlint")
  }
  ["tsc"] = (Builtins.tsc) {
    // An example's tsconfig is documentation, not part of this repository's type check: the
    // examples are consumer snapshots whose build and runtime packages are deliberately absent.
    exclude = List("playground/**")
  }
  // Unused
  ["knip"] = (Builtins.knip) {
    // Use root knip config
    workspace_indicator = "hk.pkl"
    // Disable knip auto-fix, because it's dangerous
    fix = null
  }

  // Configurations
  ["stylua"] = Builtins.stylua
  ["hk"] {
    glob = List("hk.pkl")
    check = new CommandSpec {
      command = new Command { argv = List("hk", "validate") }
      effect = "read"
    }
  }
  ["pkl-format"] = Builtins.pkl_format
  // Publish configurations
  ["attw"] {
    glob = List("packages/**/*")
    workspace_indicator = "package.json"
    check = new CommandSpec {
      command = new Command {
        argv = List("attw", "--pack", "{{workspace}}", "--profile", "esm-only")
      }
      effect = "write"
    }
  }
  ["publint"] {
    glob = List("packages/**/*")
    workspace_indicator = "package.json"
    check = new CommandSpec {
      command = new Command {
        argv = List("publint", "{{workspace}}", "--pack", "npm")
      }
      effect = "write"
    }
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
