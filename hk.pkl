amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  // Code
  ["oxlint"] = (Builtins.ox_lint) {
    check = new CommandSpec {
      command = new Command {
        argv = List("oxlint", "--deny-warnings", "--disable-nested-config", "{{files}}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("oxlint", "--deny-warnings", "--fix", "--disable-nested-config", "{{files}}")
      }
      effect = "write"
    }
  }
  ["eslint"] = (Builtins.eslint) {
    batch = false
    glob =
      List(
        // Code
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.jsx",
        "**/*.ts",
        "**/*.mts",
        "**/*.cts",
        "**/*.tsx",
        // Configurations
        "**/*.json",
        "**/*.json5",
        "**/*.jsonc",
        "**/*.yaml",
        "**/*.yml",
        "**/*.toml",
        // Documentations
        "**/*.markdown",
        "**/*.md",
        "**/*.mdc",
        "**/*.mdx",
      )
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "eslint",
            "--no-warn-ignored",
            "--cache",
            "--cache-strategy",
            "content",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv =
          List(
            "eslint",
            "--no-warn-ignored",
            "--fix",
            "--cache",
            "--cache-strategy",
            "content",
            "{{files}}",
          )
      }
      effect = "write"
    }
    depends = List("oxlint")
  }
  ["oxfmt"] = (Builtins.oxfmt) {
    // Formatting runs last: ESLint's fixes are the ones that can leave a file unformatted, and no
    // rule of this repository's config reports what Oxfmt would only reformat.
    depends = List("eslint")
  }
  ["tsc"] = (Builtins.tsc) {
    exclude = List("playground/**")
  }
  // Unused
  ["knip"] = (Builtins.knip) {
    workspace_indicator = "knip.jsonc"
    // Disable knip auto-fix, because it's dangerous
    fix = null
  }

  // Configurations
  ["stylua"] = Builtins.stylua
  ["hk"] {
    glob = List("hk.pkl")
    check = new CommandSpec {
      command = new Command { argv = List("hk", "validate") }
      effect = "read"
    }
  }
  ["pkl-format"] = Builtins.pkl_format
  // Publish configurations
  ["attw"] {
    glob = List("packages/**/*")
    workspace_indicator = "package.json"
    check = new CommandSpec {
      command = new Command {
        argv = List("attw", "--pack", "{{workspace}}", "--profile", "esm-only")
      }
      effect = "write"
    }
  }
  ["publint"] {
    glob = List("packages/**/*")
    workspace_indicator = "package.json"
    check = new CommandSpec {
      command = new Command {
        argv = List("publint", "{{workspace}}", "--pack", "npm")
      }
      effect = "write"
    }
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
