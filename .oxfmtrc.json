{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "quoteProps": "consistent",
  "objectWrap": "preserve",
  "experimentalOperatorPosition": "start",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agents/**",
    "**/*.generated.ts",
    "test/__snapshots__/**",
    "test/fixtures/**",
    "packages/config/test/fixtures/**",
    "upstream/antfu-eslint-config/**"
  ]
}
